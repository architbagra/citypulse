{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Observation",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string" },
    "timestamp": { "type": "string" },
    "zone_id": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "event_type": { "type": "string" },
    "metric": { "type": "string" },
    "value": { "type": "number" },
    "severity": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "required": ["id", "source", "timestamp", "zone_id", "value", "severity"]
}
